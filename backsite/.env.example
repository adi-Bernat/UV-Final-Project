
# הגדרות השרת
PORT=3000

# חיבור למסד הנתונים MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/uv_final_project

# מפתח סודי להתחברות מנהלים
JWT_SECRET=replace-with-a-long-random-secret

# מפתח סודי להתחברות משתמשים
USER_JWT_SECRET=replace-with-a-different-long-random-secret

# כתובת האתר
FRONTEND_URL=http://localhost:5173

# הגדרות שליחת מיילים
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-google-app-password
SMTP_FROM=your-email@gmail.com

# הפעלת שליחת מיילים אמיתיים
SEND_REAL_EMAILS=false

# הגבלת בקשות יומית
API_DAILY_LIMIT=2000
